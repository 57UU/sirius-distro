#!/bin/sh

# shellcheck source=initramfs/init_functions.sh
. ./init_functions.sh

export PATH=/usr/bin:/bin:/usr/sbin:/sbin

IP="172.16.42.1"

mkdir -p /mnt
mkdir -p /newroot

# sirius system store (spare system partition): versioned kernel modules +
# firmware, decoupling them from the userdata rootfs. Fail-safe: fall back
# to rootfs files when the store is missing anything.
find_sysmod_dev() {
    # Explicit override from kernel cmdline: sysmod_part=mmcblk0p79.
    _o="$(get_cmdline_param sysmod_part)"
    if [ -n "$_o" ]; then
        echo "/dev/$_o"
        return 0
    fi
    # GPT partlabel when the device nodes provide it.
    if [ -e /dev/disk/by-partlabel/system ]; then
        echo /dev/disk/by-partlabel/system
        return 0
    fi
    # Filesystem label stamped at mkfs time (see rootfs/build-sysmod.sh
    # IMG_LABEL; both labels we ever shipped are matched).
    blkid 2>/dev/null | sed -n 's|^\(/dev/[^:]*\):.*LABEL="\(sirius_sys\|kmod_sys\)".*|\1|p' | head -n 1
}
bind_sysmod() {
    # $1 = new-root path (/mnt or /newroot). The store mount is moved
    # inside the new root first so it survives switch_root, then the
    # versioned module dir and the firmware tree are bind-mounted.
    _root="$1"
    _kver="$(uname -r)"
    _dev="$(find_sysmod_dev)" || { echo "sysmod: no candidate device" > /dev/kmsg; return 0; }
    mkdir -p /sysmod
    if ! mount -o ro "$_dev" /sysmod 2>/dev/null; then
        echo "sysmod: mount $_dev failed" > /dev/kmsg
        return 0
    fi
    mkdir -p "$_root/mnt/sysmod"
    if ! mount --move /sysmod "$_root/mnt/sysmod" 2>/dev/null; then
        echo "sysmod: move failed" > /dev/kmsg
        umount /sysmod
        return 0
    fi
    _bound=0
    if [ -d "$_root/mnt/sysmod/lib/modules/$_kver" ]; then
        mkdir -p "$_root/lib/modules/$_kver"
        if mount -o bind "$_root/mnt/sysmod/lib/modules/$_kver" "$_root/lib/modules/$_kver" 2>/dev/null; then
            echo "sysmod: bound modules $_kver" > /dev/kmsg
            _bound=1
        fi
    fi
    if [ -d "$_root/mnt/sysmod/lib/firmware" ]; then
        mkdir -p "$_root/lib/firmware"
        if mount -o bind "$_root/mnt/sysmod/lib/firmware" "$_root/lib/firmware" 2>/dev/null; then
            echo "sysmod: bound firmware" > /dev/kmsg
            _bound=1
        fi
    fi
    [ "$_bound" = 1 ] || echo "sysmod: nothing bound, using rootfs files" > /dev/kmsg
}
mount_proc_sys_dev

setup_mdev

ROOT="$(get_cmdline_param rootfs_path)"
ORIG_ROOT=""
PART="$(get_cmdline_param rootfs_part)"
DEBUG="$(get_cmdline_param initrd_hang)"

# Default set by installer
PART="${PART:-sda17}"

echo "ROOT is $ROOT" > /dev/kmsg

setup_firmware_path

setup_usb_network
start_udhcpd

timeout=0
until [ $timeout -eq 10 ]; do
    if [ -n "$(blkid | grep "/dev/$PART" | cut -d ":" -f 1 | head -n 1)" ]; then
	break
    fi
    sleep 1
    timeout=$(($timeout+1))
done

if [ $timeout -eq 10 ]; then
    echo "$PART never was probed/brought up" > /dev/kmsg
    exit 1
fi

if [ -n "$DEBUG" ]; then
    start_telnetd
fi

# This should be detected or configured better but for now this will do.
mount "/dev/$PART" /mnt > /dev/kmsg

if [ -z "$ROOT" ]; then
    echo "ROOT is empty, assuming $PART is root" > /dev/kmsg
    if [ -n "$DEBUG" ]; then
        echo "HALTING WITH TELNET AS initrd_hang SET ON CMDLINE" > /dev/kmsg
        while true; do sleep 300; done
    fi
    bind_sysmod /mnt
    exec switch_root /mnt /sbin/init
    exit
fi

echo "Mounted /dev/$PART as /mnt" > /dev/kmsg
#If $ROOT isn't a valid path, check /data/, /data/.stowaways and /data/media/0 (storage)
if [ ! -f "/mnt/$ROOT" ]; then
    ORIG_ROOT="$ROOT"
    echo "Rootfs isn't /mnt/$ROOT" > /dev/kmsg
    ROOT="$(basename "$ROOT")"
fi
if [ ! -f "/mnt/$ROOT" ]; then
    echo "Rootfs isn't /mnt/$ROOT" > /dev/kmsg
    ROOT=".stowaways/$(basename "$ROOT")"
fi
if [ ! -f "/mnt/$ROOT" ]; then
    echo "Rootfs isn't /mnt/$ROOT" > /dev/kmsg
    ROOT="media/0/$(basename "$ROOT")"
fi

if [ ! -f "/mnt/$ROOT" ]; then
    echo "Rootfs isn't /mnt/$ROOT" > /dev/kmsg
    echo "Couldn't find $ORIG_ROOT" > /dev/kmsg
	echo "Contents of '/mnt/$(dirname "$ORIG_ROOT")':" > /dev/kmsg
	ls -la "/mnt/$(dirname "$ORIG_ROOT")/" > /dev/kmsg
    echo "Halting" > /dev/kmsg
    while true; do sleep 300; done
fi

mount "/mnt/$ROOT" /newroot # pmos-phosh.img

echo "Moving image partition mount into rootfs" > /dev/kmsg
mkdir -p /newroot/mnt/data
mount --move /mnt /newroot/mnt/data

# TEMP-DISABLED for gadget SSH: setup_usb_host_mode

echo "Switching root" > /dev/kmsg
if [ -n "$DEBUG" ]; then
    echo "HALTING WITH TELNET AS initrd_hang SET ON CMDLINE" > /dev/kmsg
    while true; do sleep 300; done;
fi
bind_sysmod /newroot
exec switch_root /newroot /sbin/init

echo "Failed to switch root" > /dev/kmsg
# Now we kernel panic :(
