#!/bin/sh
# sirius-kernel-glue: the systemd generator that exposes the kernel-coupled
# glue store on the system partition to the userdata rootfs.
#
# Lives in the system-partition image (/glue/bin) together with the manifest
# it consumes, so the parser and its input always ship as one unit.  The only
# rootfs-side piece is a 4-line stub in system-generators/ that execs this
# file; the stub never needs to know anything about the glue contents.
#
# Manifest schema v1 (generated by kernel/gen-glue-manifest.sh, never hand-
# written).  One record per line, fields space-separated:
#   abi <n>                      glue ABI, must match GLUE_ABI below
#   unit <relpath>               unit file to expose (e.g. units/foo.service)
#   dropin <unit> <relpath>      drop-in for a unit of any origin
#   wants <target> <unit>        enablement (.wants symlink)
#   run <dest> <relpath>         consumed by sirius-glue-setup.service, not
#                                by the generator (which only emits units).
# Unknown record kinds are logged and ignored (forward compatibility).
#
# Failure policy: never block boot.  Any error is logged to /dev/kmsg and the
# generator exits 0, leaving the system in a degraded (but bootable) state.
# The system partition is mounted read-only; this script only creates
# symlinks in the generator output directory and keeps no persistent state.
set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin

NORMAL=${1:-}
# Test hooks: unset in production, used by scripts/test-glue.sh on the host.
GLUE=${SIRIUS_GLUE_ROOT:-/mnt/sysmod/glue}
GLUE_ABI=1

log() { echo "sirius-glue: $*" > /dev/kmsg 2>/dev/null || true; }

[ -n "$NORMAL" ] || exit 0

if [ ! -f "$GLUE/manifest" ]; then
    log "no $GLUE/manifest (system partition not mounted?), skipping"
    exit 0
fi

linked=0
failed=0
while read -r kind a b; do
    case "${kind:-}" in
        ''|\#*) continue ;;
        abi)
            if [ "$a" != "$GLUE_ABI" ]; then
                log "manifest ABI $a != generator ABI $GLUE_ABI, skipping"
                exit 0
            fi
            ;;
        unit)
            if ln -sfn "$GLUE/$a" "$NORMAL/${a##*/}"; then
                linked=$((linked + 1))
            else
                failed=$((failed + 1))
                log "cannot link unit ${a##*/} -> $GLUE/$a"
            fi
            ;;
        dropin)
            if mkdir -p "$NORMAL/$a.d" &&
               ln -sfn "$GLUE/$b" "$NORMAL/$a.d/${b##*/}"; then
                :
            else
                failed=$((failed + 1))
                log "cannot link drop-in $a/${b##*/} -> $GLUE/$b"
            fi
            ;;
        wants)
            if mkdir -p "$NORMAL/$a.wants" &&
               ln -sfn "$NORMAL/$b" "$NORMAL/$a.wants/$b"; then
                :
            else
                failed=$((failed + 1))
                log "cannot link $a.wants/$b"
            fi
            ;;
        run)
            # Non-unit configuration belongs to an early boot service, so
            # generator sandboxing and daemon-reload do not affect it.
            ;;
        *)
            log "unknown manifest kind '$kind', ignored"
            ;;
    esac
done < "$GLUE/manifest"

# Never fail the boot, but never claim success for links that were not created
# either: dmesg is the documented acceptance check for this generator.
if [ "$failed" -ne 0 ]; then
    log "linked $linked units from $GLUE (ABI $GLUE_ABI), $failed link(s) failed"
else
    log "linked $linked units from $GLUE (ABI $GLUE_ABI)"
fi
exit 0
