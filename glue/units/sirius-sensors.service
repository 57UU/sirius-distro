[Unit]
Description=Qualcomm Sensor Core (SSC) file server + registry (sirius)
Documentation=https://github.com/linux-msm/hexagonrpc
# hexagonrpcd must attach the ADSP default listener before adsprpcd does:
# on sdm670 there is no SLPI, so sensors live in the ADSP and the listener is
# globally unique (see docs/SENSORS.md).
After=qrtr-ns.service
Before=adsprpcd-audiopd.service adsprpcd-rootpd.service
Wants=qrtr-ns.service
ConditionPathExists=/dev/fastrpc-adsp-secure

[Service]
Type=simple
# Private libraries (libhexagonrpc/libssc/libprotobuf-c) ship next to the
# binaries in the glue store, so the rootfs only needs the distro glib/qmi.
Environment=LD_LIBRARY_PATH=/mnt/sysmod/glue/bin
ExecStartPre=/mnt/sysmod/glue/bin/sirius-sensors-setup
ExecStart=/mnt/sysmod/glue/bin/hexagonrpcd -f /dev/fastrpc-adsp-secure -s -R /run/sirius-qcom
ExecStopPost=/mnt/sysmod/glue/bin/sirius-sensors-setup --teardown
Restart=on-failure
RestartSec=3
