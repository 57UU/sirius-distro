[Unit]
Description=Prepare Sirius runtime device configuration and factory WiFi MAC
DefaultDependencies=no
After=systemd-remount-fs.service
Before=systemd-udevd.service systemd-udev-trigger.service
Before=systemd-modules-load.service systemd-sysctl.service
Before=systemd-tmpfiles-setup-dev-early.service systemd-tmpfiles-setup-dev.service systemd-tmpfiles-setup.service
Before=NetworkManager.service sysinit.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/mnt/sysmod/glue/scripts/sirius-glue-setup
TimeoutStartSec=30
