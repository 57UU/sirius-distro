[Unit]
Description=Sirius zram swap (lz4, 50 percent of RAM)
# No After=: the script modprobes zram itself, so there is no ordering
# need on systemd-modules-load.service; start as early as possible.

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
ExecStart=/usr/local/sbin/sirius-zram start
ExecStop=/usr/local/sbin/sirius-zram stop

[Install]
WantedBy=multi-user.target
