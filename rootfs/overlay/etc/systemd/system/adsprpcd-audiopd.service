[Unit]
Description=Qualcomm ADSP RPC daemon (audio PD listener)
After=qrtr-ns.service pd-mapper.service tqftpserv.service adsprpcd-rootpd.service
Wants=qrtr-ns.service

[Service]
Environment=ADSP_LIBRARY_PATH=/usr/lib/firmware/qcom/sdm710/pyxis/adsp
ExecStart=/usr/local/bin/adsprpcd audiopd adsp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
