[Unit]
Description=Watch SIM hotplug via UIM indications (sirius)
# Only waits for QRTR/EFS. No Before=ModemManager needed: Type=simple counts as
# started immediately and never blocks MM; uimwatch exits when QRTR is
# unavailable and Restart brings it back, so starting even later than MM does
# not affect the final result.
After=qrtr-ns.service rmtfs.service

[Service]
Type=simple
# uimwatch exits after modem restart / QRTR reconnect; restart keeps it listening
Restart=always
RestartSec=5
ExecStart=/usr/local/bin/uimwatch

[Install]
WantedBy=multi-user.target
