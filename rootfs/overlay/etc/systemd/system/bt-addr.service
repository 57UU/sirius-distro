[Unit]
Description=Set stable Bluetooth public address (sirius)
# Pulled by bluetooth.service itself (not multi-user.target): the
# address must be set before bluetoothd starts, but nothing else waits
# for it, so the hci0 firmware wait stays off the boot critical path.
After=sys-subsystem-bluetooth-devices-hci0.device
Wants=sys-subsystem-bluetooth-devices-hci0.device
Before=bluetooth.service
ConditionPathExists=/sys/class/bluetooth/hci0
JobTimeoutSec=90
[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=45
ExecStartPre=-/usr/bin/pkill -9 -x btmgmt
ExecStart=/usr/local/sbin/sirius-bt-addr
[Install]
WantedBy=bluetooth.service
