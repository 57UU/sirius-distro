[Unit]
Description=Orbital mobile dashboard (default UI for sirius server)
# No After=multi-user.target: the UI comes up in parallel with late boot,
# not after it. DSI/input probe in the kernel long before userspace; if a
# node is still missing, Orbital exits and Restart retries.
[Service]
Type=simple
WorkingDirectory=/opt/orbital
Environment=QT_SCALE_FACTOR=2.2
# Input nodes use the stable names from 70-sirius-input.rules; eventN numbers
# move when a new device probes (haptics became event0 in 2.1). The touch
# inhibit sysfs path is derived from the touch node by run.sh.
Environment=ORBITAL_TOUCH_INPUT_PATH=/dev/input/sirius-touch
Environment=ORBITAL_POWER_KEY_PATH=/dev/input/sirius-power
Environment=ORBITAL_VOLUME_KEY_PATH=/dev/input/sirius-vol-up,/dev/input/sirius-vol-down
ExecStart=/opt/orbital/run.sh
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
