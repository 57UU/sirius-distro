[Unit]
Description=Sirius speaker route init (UCM HiFi/Speaker)
# NOTE: After=sound.target alone is NOT enough (verified 2026-10-03):
# sound.target is only ordered after alsa-state/alsa-restore, nothing wires
# it to our card, and the card probes ~30s late (ADSP + userspace PD chain).
# The service once ran the same second the card appeared and failed with
# "no soundcards found". So order on the card device unit itself; the
# Restart below stays as backstop for re-probe flaps.
# multi-user.target keeps boot from waiting ~30s for the late card;
# the same Restart covers the route once the card appears.
After=sound.target dev-snd-controlC0.device multi-user.target
Requires=dev-snd-controlC0.device
ConditionPathExists=/usr/share/alsa/ucm2/SE/SE.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/alsaucm -c SE set _verb HiFi set _enadev Speaker
# WirePlumber/ACP already probed the card the instant it appeared, while the
# route above was still off; that probe fails (-EINVAL from snd_pcm_open) and
# the card is left with only "off"/"pro-audio", i.e. no sink at all (GNOME then
# shows "Dummy Output" — see docs/AUDIO-BRINGUP.md §6). ACP never re-probes, so
# re-create the device now that the route is in place. Harmless when a sink
# already exists or nobody is logged in.
ExecStartPost=-/usr/local/sbin/sirius-audio-refresh
RemainAfterExit=yes
# Card probes late (ADSP + userspace PDs take ~30s); first-boot run may hit
# "no soundcards found". Retry with backoff until the UCM route sticks.
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
