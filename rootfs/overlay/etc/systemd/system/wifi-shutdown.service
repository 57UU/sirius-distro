[Unit]
Description=Teardown WiFi before modem stops (sirius shutdown fix)
# Stop-job ordering is the reverse of startup: After= here means this
# ExecStop runs BEFORE NM/MM/modem stop. (A start-job with Before=
# cannot do that: on shutdown it runs after everything stopped, as
# shipped images demonstrated: wifi-shutdown started 10s after rmtfs died.)
After=NetworkManager.service ModemManager.service rmtfs.service tqftpserv.service pd-mapper.service
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/local/bin/wifi-shutdown
[Install]
WantedBy=multi-user.target
