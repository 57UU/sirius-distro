[Unit]
Description=Build UIM provisioning session before ModemManager (sirius)
# Act only after modem/EFS services are ready; must precede ModemManager,
# otherwise MM sees sim-missing and gives up on the modem.
After=qrtr-ns.service rmtfs.service tqftpserv.service pd-mapper.service
Before=ModemManager.service
Wants=qrtr-ns.service rmtfs.service

[Service]
Type=oneshot
# No RemainAfterExit on purpose: exit to inactive so the companion timer can
# fire it again as a fallback check (RemainAfterExit would keep it active and
# the timer would never fire).
ExecStart=/usr/local/bin/sirius-modem-uim
# Script waits up to 40s for UIM (measured modem ready in 10~20s); ample margin.
# Cost: if the modem never comes up, boot is delayed up to 40s (MM waits on this
# oneshot) - known trade-off.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
