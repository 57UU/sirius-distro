#!/bin/sh
# sirius-wifi-auto: watchdog that reconnects wifi when the link is down.
# A systemd timer (sirius-wifi-auto.timer) runs one pass every 5 min.
# State on/off persists in /var/lib/sirius-wifi-auto/state (default: on).
#   sudo sirius-wifi-auto on|off|status   (no args = one watchdog pass)
# Multi-network policy: candidates are wifi profiles with autoconnect=yes,
# ordered by autoconnect-priority (high first), then by last-use timestamp
# (recent first); each is tried in turn, first success wins. The pass skips
# when the wifi radio is off or the device was disconnected by hand
# (NM marks device autoconnect blocked in that case).
# NOTE: profile names containing ':' confuse the nmcli -t parsing below;
# rename such a profile if you hit this.
STATE_DIR=/var/lib/sirius-wifi-auto
STATE_FILE=$STATE_DIR/state
TAG=sirius-wifi-auto

log() { echo "$TAG: $1"; logger -t "$TAG" "$1" 2>/dev/null || true; }

state_get() {
  if [ -f "$STATE_FILE" ]; then
    cat "$STATE_FILE"
  else
    echo on
  fi
}

state_set() {
  mkdir -p "$STATE_DIR"
  echo "$1" > "$STATE_FILE"
  log "state -> $1"
}

# "DEV:STATE" of the first managed wifi device, e.g. "wlan0:connected".
wifi_devinfo() {
  nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null | awk -F: '$2 == "wifi" {print $1 ":" $3; exit}'
}

# Ordered candidate list, one per line: "PRIO<TAB>TS<TAB>UUID<TAB>NAME".
# UUID-first field order keeps parsing stable (names may contain ':').
candidates() {
  nmcli -t -f UUID,TYPE,AUTOCONNECT,AUTOCONNECT-PRIORITY,TIMESTAMP,NAME con show 2>/dev/null \
    | awk -F: '$2 == "802-11-wireless" && $3 == "yes" {ts=$5; name=$6; for (i=7; i<=NF; i++) name=name ":" $i; print $4 "\t" ts "\t" $1 "\t" name}' \
    | sort -t "$(printf '\t')" -k1,1nr -k2,2nr
}

do_status() {
  echo "state: $(state_get) (file: $STATE_FILE)"
  echo "radio wifi: $(nmcli -t -f WIFI radio 2>/dev/null)"
  info=$(wifi_devinfo)
  echo "device: ${info%%:*} state: ${info#*:}"
  echo "active: $(nmcli -t -f NAME con show --active 2>/dev/null | tr '\n' ' ')"
  echo "candidates (priority, last-used, uuid, name):"
  candidates | sed 's/^/  /'
}

do_pass() {
  if [ "$(state_get)" != "on" ]; then
    log "state=off, skip"
    exit 0
  fi
  if [ "$(nmcli -t -f WIFI radio 2>/dev/null)" != "enabled" ]; then
    log "wifi radio off, skip"
    exit 0
  fi
  info=$(wifi_devinfo)
  DEV=${info%%:*}
  ST=${info#*:}
  if [ -z "$DEV" ]; then
    log "no wifi device, skip"
    exit 0
  fi
  case "$ST" in
    connected|connecting)
      exit 0
      ;;
  esac
  if [ "$(nmcli -t -f GENERAL.AUTOCONNECT dev show "$DEV" 2>/dev/null | awk '{print $2}')" = "no" ]; then
    log "$DEV disconnected by hand (autoconnect blocked), skip"
    exit 0
  fi
  log "$DEV state=$ST, trying candidates"
  CAND_FILE=$(mktemp)
  trap 'rm -f "$CAND_FILE"' EXIT INT TERM
  candidates > "$CAND_FILE"
  while IFS="$(printf '\t')" read -r PRIO TS UUID NAME; do
    [ -n "$UUID" ] || continue
    log "try '$NAME' (prio=$PRIO last=$TS)"
    if timeout 100 nmcli --wait 60 con up uuid "$UUID" >/dev/null 2>&1; then
      sleep 2
      if [ "$(wifi_devinfo)" = "$DEV:connected" ]; then
        log "connected via '$NAME'"
        exit 0
      fi
    fi
    log "'$NAME' failed, next"
  done < "$CAND_FILE"
  log "all candidates failed, retry in 5 min"
  exit 0
}

case "${1:-pass}" in
  on|off) state_set "$1" ;;
  status) do_status ;;
  pass) do_pass ;;
  *) echo "usage: $0 [on|off|status]" 1>&2; exit 1 ;;
esac